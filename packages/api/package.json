{
  "name": "@slackwater/api",
  "version": "1.0.0-beta.3",
  "description": "HTTP API for tide and current predictions",
  "keywords": [
    "slackwater",
    "tides",
    "tide-prediction",
    "currents",
    "tidal-currents",
    "api",
    "openapi",
    "express"
  ],
  "homepage": "https://openwaters.io/tides/slackwater/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwatersio/slackwater.git",
    "directory": "packages/api"
  },
  "author": "Brandon Keepers <brandon@openwaters.io>",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "slackwater-server": "./bin/server.js"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "prepack": "npm run build",
    "start": "node bin/server.js"
  },
  "dependencies": {
    "@slackwater/database": "^1.0.0-beta.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "slackwater": "^1.0.0-beta.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "express-openapi-validator": "^5.1.6",
    "supertest": "^7.2.2"
  },
  "inlinedDependencies": {
    "@types/express-serve-static-core": "5.1.3"
  }
}
